rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // دوال مساعدة
    function signedIn() { return request.auth != null; }
    function em()       { return request.auth.token.email; }
    function isOwner()  { return signedIn() && em() == 'a2@dhtrd.com'; }
    function hasRole()  { return signedIn() && exists(/databases/$(database)/documents/roles/$(em())); }
    function roleData() { return get(/databases/$(database)/documents/roles/$(em())).data; }
    function myRole()   { return hasRole() ? roleData().role : ''; }
    function active()   { return isOwner() || (hasRole() && roleData().active == true); }
    function canWriteDays() { return isOwner() || (active() && myRole() == 'مُدخِل اليوميات'); }

    // وثائق الأيام: قراءة لكل مستخدم فعّال، كتابة للمالك أو مُدخِل اليوميات
    match /days/{day} {
      allow read:  if active();
      allow write: if canWriteDays();
    }

    // الإعدادات العامة (اسم النشاط/الرصيد الافتتاحي/الفروع/طرق الدفع/الشعار): كتابة للمالك فقط
    match /meta/{doc} {
      allow read:  if active();
      allow write: if isOwner();
    }

    // الأدوار: قراءة لكل مسجّل؛ الإنشاء/الحذف للمالك؛ ويحدّث المستخدم آخر دخوله فقط
    match /roles/{userEmail} {
      allow read:          if signedIn();
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || ( signedIn() && userEmail == em()
             && request.resource.data.role   == resource.data.role
             && request.resource.data.active == resource.data.active
             && request.resource.data.name   == resource.data.name );
    }

    // درج Dropbox (اختياري — للنسخ الاحتياطي لدى المالك)
    match /appConfig/{doc} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // منع أي شيء آخر
    match /{document=**} { allow read, write: if false; }
  }
}
