rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== دوال مساعدة =====
    function signedIn() { return request.auth != null; }
    function em()       { return request.auth.token.email; }
    function isOwner()  { return signedIn() && em() == 'a2@dhtrd.com'; }
    function hasRole()  { return signedIn() && exists(/databases/$(database)/documents/roles/$(em())); }
    function roleData() { return get(/databases/$(database)/documents/roles/$(em())).data; }
    function myRole()   { return hasRole() ? roleData().role : ''; }
    function active()   { return isOwner() || (hasRole() && roleData().active == true); }

    // استثناء الفرد لصلاحية «الإدخال» (البند ٢): يُخزَّن المالكُ perms في وثيقة الدور.
    // allow = منح صريح، deny = منع صريح، غيره = يرث الدور.
    function permEntry() {
      return (hasRole() && 'perms' in roleData() && 'entry' in roleData().perms)
        ? roleData().perms.entry : '';
    }
    // قرار كتابة الأيام (يطابق نموذج العميل رباعي الطبقات — البند ٤):
    // المالك؛ أو (فعّال و [منحٌ صريح للإدخال] أو [ليس ممنوعاً و دورُه الأساسي مُدخِل اليوميات]).
    function canWriteDays() {
      return isOwner() || ( active() && (
        permEntry() == 'allow' ||
        ( permEntry() != 'deny' && myRole() == 'مُدخِل اليوميات' )
      ));
    }

    // ===== قفل الحقول + انتقالات الحالة على مستوى الخادم (البند ٦) =====
    // حالة اليومية: مسودة → مرحّلة → مقفلة (+ ملغاة)، وإعادة كمسودة من أي حالة.
    // الحالة الفعّالة — تطابق تماماً منطق التطبيق dayStatus():
    //   «approved» (طباعة/اعتماد اليومية) وأي حالة غير معروفة تُترجَم إلى مقفلة/مرحّلة/مسودة حسب علم القفل.
    //   بدون هذا كان الخادم يرفض أي تغيير على يومية مطبوعة (approved) لأنه لا يعرف هذه الحالة ⇒ «تعذّرت المزامنة».
    function dstatus(d) {
      let s = ('status' in d) ? d.status : 'draft';
      let lk = ('locked' in d) && d.locked == true;
      return (s == 'draft' || s == 'posted' || s == 'locked' || s == 'cancelled') ? s
           : (s == 'approved' ? (lk ? 'locked' : 'posted') : (lk ? 'locked' : 'draft'));
    }
    // الحقول المالية التي لا يجوز تغييرها بعد الترحيل (إلا بإعادتها مسودة):
    function finKeys() { return ['rows','expenses','incomes','bankDeposit','carryIn']; }
    function noFinChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(finKeys());
    }
    // تُسمح التغييرات المالية فقط والحالةُ مسودةٌ قبل الكتابة أو بعدها (تحرير/ترحيل/إعادة فتح):
    function finChangeOk() {
      return dstatus(resource.data) == 'draft'
          || dstatus(request.resource.data) == 'draft'
          || noFinChange();
    }
    // انتقالات مسموحة فقط (يمنع القفز مثل مسودة→مقفلة):
    function validTransition() {
      let o = dstatus(resource.data);
      let n = dstatus(request.resource.data);
      return (o == n)
        || (o == 'draft'     && (n == 'posted' || n == 'cancelled'))
        || (o == 'posted'    && (n == 'locked' || n == 'cancelled' || n == 'draft'))
        || (o == 'locked'    && (n == 'draft'  || n == 'cancelled'))
        || (o == 'cancelled' && (n == 'draft'));
    }

    // ===== وثائق الأيام =====
    match /days/{day} {
      allow read:   if active();
      allow create: if canWriteDays();
      allow update: if canWriteDays() && validTransition() && finChangeOk();
      allow delete: if canWriteDays();
    }

    // ===== الإعدادات العامة + الأدوار المخصّصة + أسماء العرض (meta/config): كتابة للمالك فقط =====
    match /meta/{doc} {
      allow read:  if active();
      allow write: if isOwner();
    }

    // ===== الأدوار: قراءة لكل مسجّل؛ الإنشاء/الحذف للمالك =====
    // المالك يعدّل كل شيء. المستخدم يعدّل وثيقته الخاصة في حقول ذاتية فقط:
    // lastLogin + prefs + updatedTs — ولا يمسّ role/perms/branches/active/name (يمنع تصعيد الصلاحية).
    match /roles/{userEmail} {
      allow read:            if signedIn();
      allow create, delete:  if isOwner();
      allow update: if isOwner()
        || ( signedIn() && userEmail == em()
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['lastLogin','prefs','updatedTs']) );
    }

    // ===== درج Dropbox (اختياري) =====
    match /appConfig/{doc} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // ===== سجل النشاط: إلحاقي بختم الفاعل (البند ٨) =====
    // إنشاء لكل فعّال؛ لا يُعدَّل أي حدثٍ أبداً (غير قابل للتغيير)؛ الحذف (للصيانة/الاحتفاظ) للمالك فقط.
    match /activity/{id} {
      allow read:    if active();
      allow create:  if active();
      allow update:  if false;
      allow delete:  if isOwner();
    }

    // ===== الاعتمادات: المالك أو المدير المالي (اعتماد/إعادة) أو مُدخِل اليوميات (إرسال) =====
    match /approvals/{date} {
      allow read:  if active();
      allow write: if isOwner() || myRole() == 'المدير المالي' || myRole() == 'مُدخِل اليوميات';
    }

    // ===== منع أي شيء آخر =====
    match /{document=**} { allow read, write: if false; }
  }
}
